    "a4": {
      "file": "assets/audio/a4.mp3",
      "duration": 3.295,
      "bytes": 27116,
      "sha256": "018b2a038705c6706d3cbbdadf609796a845ed1437d7b94f26f7d7ffdea03647",
      "segments": [
        {
          "start": 0.18,
          "end": 2.975,
          "speaker": "Luca",
          "text": "Iris, it's me. Don't sign anything tonight."
        }
      ]
    },
    "a5": {
      "file": "assets/audio/a5.mp3",
      "duration": 9.849,
      "bytes": 79532,
      "sha256": "ad1d3046a32a4432d72a699b0e3c723e1b35833dcf83ab7454f5b457f52cad13",
      "segments": [
        {
          "start": 0.18,
          "end": 1.58,
