    "u1": {
      "file": "assets/audio/u1.mp3",
      "duration": 11.431,
      "bytes": 92204,
      "sha256": "69b3fce19a3805f12a362f8c68b7375cb595b1ff2157381f9751c4ccf21b9b52",
      "segments": [
        {
          "start": 0.18,
          "end": 11.111,
          "speaker": "Operator",
          "text": "The recorder clock was two minutes fast. That is in the export note. Please use the corrected time when you compare it with a phone record. We cannot identify the person in that picture for you."
        }
      ]
    },
    "u2": {
      "file": "assets/audio/u2.mp3",
      "duration": 16.301,
      "bytes": 131180,
      "sha256": "d2bea64d37c0b2d88b44f70df15d8b27681194570cced367c9748e132f04b2a9",
      "segments": [
        {
          "start": 0.18,
          "end": 9.051,
          "speaker": "MOTH",
          "text": "I gave you the archive. I did not tell you to stop asking questions. Read the statements before you decide which person sounds convincing."
        },
        {
          "start": 9.371,
          "end": 11.505,
          "speaker": "Investigator",
          "text": "Why do you care what I decide?"
        },
        {
          "start": 11.825,
          "end": 15.981,
          "speaker": "MOTH",
          "text": "Because nobody else is reading it properly. Call me back when you have."
        }
      ]
    },
    "u3": {
      "file": "assets/audio/u3.mp3",
      "duration": 9.724,
      "bytes": 78572,
      "sha256": "80e8b2e29b116e02bec263a87fb43863911b58735d79e8bcdcbf98a310d7b5c0",
      "segments": [
        {
          "start": 0.18,
          "end": 9.404,
          "speaker": "Mara",
          "text": "I know how this looks. Freelance work is not the same thing as being part of his company. Please do not mix the two up. Ask me what I actually did."
        }
      ]
    },
    "u4": {
      "file": "assets/audio/u4.mp3",
      "duration": 8.099,
      "bytes": 65516,
      "sha256": "941c230c016f34155f6fc2d48be04e2250b473a91903406f77692b521f577716",
      "segments": [
        {
          "start": 0.18,
          "end": 7.779,
          "speaker": "Elena",
          "text": "I left tea... and a strip of my own sleeping tablets in the box, for emergencies. I never told anyone. It would look terrible."
        }
      ]
    },
    "u5": {
      "file": "assets/audio/u5.mp3",
      "duration": 6.769,
      "bytes": 54956,
      "sha256": "7c9bd4c6b0962472f85663d8faa6d9775d8ac4939497d3f10d5fc11a7f482a6b",
      "segments": [
        {
          "start": 0.18,
          "end": 6.449,
          "speaker": "MOTH",
          "text": "Every copy has a source. You keep asking what it says. Have you asked who had permission to change it?"
        }
      ]
    },
    "u6": {
      "file": "assets/audio/u6.mp3",
      "duration": 5.229,
      "bytes": 42476,
      "sha256": "5af1f0bfc9182b02193843cf2442116e51b61ad96f1b1fc9b1727266c2991a8c",
      "segments": [
        {
          "start": 0.18,
          "end": 3.211,
